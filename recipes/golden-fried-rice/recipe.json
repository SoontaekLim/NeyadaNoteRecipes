      "amount": "2개"
    },
    {
      "name": "달걀",
      "amount": "3~4개"
    },
    {
      "name": "스팸",
      "amount": "약 50g"
    },
    {
      "name": "당근",
      "amount": "약 70g"
    },
    {
      "name": "대파",
      "amount": "약 40g"
    },
    {
      "name": "치킨스톡",
      "amount": "2/3스푼"
    },
    {
      "name": "식용유",
      "amount": "2~3스푼"
    },
    {
      "name": "물(스팸 데치기용)",
      "amount": "적당량"
    }
