      "amount": "15ml"
    },
    {
      "name": "버터",
      "amount": "20g"
    },
    {
      "name": "육수(채소 또는 닭)",
      "amount": "650ml"
    },
    {
      "name": "생크림",
      "amount": "100ml"
    },
    {
      "name": "파르메산 치즈",
      "amount": "40g"
    },
    {
      "name": "소금",
      "amount": "1g"
    },
    {
      "name": "검은후추",
      "amount": "1g"
    },
    {
      "name": "파슬리",
      "amount": "2g"
