{
  "format": "neyadanote.recipe",
  "schemaVersion": 1,
  "id": "gochujang-myeolchi-bokkeum",
  "locale": "ko-KR",
  "title": "고추장 멸치볶음",
  "summary": "중멸치에 매콤달콤한 고추장 양념을 입히고 청양고추와 참기름으로 향을 더한 한식 밑반찬입니다.",
  "servings": 2,
  "coverImage": "images/cover.webp",
  "tags": [
    "반찬",
    "한식"
  ],
  "ingredients": [
    {
      "name": "중멸치",
      "amount": "1컵"
    },
    {
      "name": "청양고추",
      "amount": "1개"
    },
    {
      "name": "식용유",
      "amount": "3큰술"
    },
    {
      "name": "물엿",
      "amount": "2큰술"
    },
    {
      "name": "황설탕",
      "amount": "1/2큰술"
    },
    {
      "name": "고추장",
      "amount": "1큰술"
    },
    {
      "name": "고운 고춧가루",
      "amount": "1/2큰술"
    },
    {
      "name": "참기름",
      "amount": "1큰술"
    },
    {
      "name": "통깨",
      "amount": "1작은술"
    }
  ],
  "steps": [
    {
      "id": 1,
      "description": "볼에 고추장 1큰술, 고운 고춧가루 1/2큰술, 물엿 2큰술, 황설탕 1/2큰술을 넣어 섞습니다. 청양고추 1개는 길이로 반을 가르고 3mm 두께로 썹니다.",
      "image": "images/step-1.webp"
    },
    {
      "id": 2,
      "description": "중멸치 1컵을 준비합니다. 국물용 큰 멸치라면 머리와 내장, 굵은 가시를 제거합니다. 팬에 식용유 3큰술을 두르고 중불에서 멸치를 볶아 비린 향을 줄이고 바삭하게 만듭니다.",
      "image": "images/step-2.webp"
    },
    {
      "id": 3,
      "description": "멸치를 팬의 한쪽으로 모으고 약불로 낮춥니다. 빈 공간에 양념을 부어 저으면서 설탕을 녹이고 작은 기포가 전체에 올라올 때까지 끓입니다.",
      "image": "images/step-3.webp"
    },
    {
      "id": 4,
      "description": "멸치를 양념에 넣어 고루 버무린 다음 썰어 둔 청양고추를 넣고 짧게 볶습니다. 양념이 타지 않도록 계속 저어 줍니다.",
      "image": "images/step-4.webp"
    },
    {
      "id": 5,
      "description": "불을 끄고 참기름 1큰술과 통깨 1작은술을 넣어 섞습니다. 접시에 담아 식혀 먹습니다.",
      "image": "images/step-5.webp"
    }
  ]
}
