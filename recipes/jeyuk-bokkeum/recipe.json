  "steps": [
    {
      "id": 1,
      "description": "돼지고기는 한입 크기로 썰고 양파는 굵게 채 썰며 대파는 어슷하게 썹니다."
    },
    {
      "id": 2,
      "description": "고추장, 고춧가루, 진간장, 설탕, 다진 마늘, 참기름을 섞어 양념장을 만듭니다."
    },
    {
      "id": 3,
      "description": "돼지고기에 양념장을 넣고 양념이 고루 묻도록 버무립니다."
    },
    {
      "id": 4,
      "description": "팬에 식용유를 두르고 중강불로 달군 뒤 양념한 돼지고기를 넣어 4~5분 볶습니다."
    },
    {
      "id": 5,
      "description": "돼지고기가 거의 익으면 양파와 대파를 넣고 2~3분 더 볶아 돼지고기를 완전히 익힙니다."
    },
    {
      "id": 6,
      "description": "불을 끄고 통깨를 뿌려 마무리합니다."
    }
  ]
