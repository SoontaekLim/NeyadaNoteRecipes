      "amount": "20g"
    },
    {
      "name": "마늘",
      "amount": "4쪽"
    },
    {
      "name": "타이 고추",
      "amount": "2개"
    },
    {
      "name": "굴소스",
      "amount": "1큰술"
    },
    {
