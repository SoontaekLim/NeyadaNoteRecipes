      "amount": "1큰술"
    },
    {
      "name": "간장",
      "amount": "1작은술"
    },
    {
      "name": "설탕",
      "amount": "1작은술"
    },
    {
      "name": "물",
      "amount": "2큰술"
    },
    {
      "name": "식용유",
      "amount": "2큰술"
