{
  "format": "neyadanote.recipe",
  "schemaVersion": 1,
  "id": "gamja-chae-bokkeum",
  "locale": "ko-KR",
  "title": "감자채볶음",
  "summary": "감자와 당근, 양파를 가늘게 썰어 아삭하고 담백하게 볶은 기본 한식 밑반찬입니다.",
  "servings": 2,
  "coverImage": "images/cover.webp",
  "tags": [
    "반찬",
    "한식"
  ],
  "ingredients": [
    {
      "name": "감자",
      "amount": "2개 (약 300g)"
    },
    {
      "name": "양파",
      "amount": "1/4개 (약 50g)"
    },
    {
      "name": "당근",
      "amount": "1/4개 (약 40g)"
    },
    {
      "name": "찬물",
      "amount": "감자가 잠길 만큼"
    },
    {
      "name": "식용유",
      "amount": "1과 1/2큰술"
    },
    {
      "name": "소금",
      "amount": "1/3작은술"
    },
    {
      "name": "후춧가루",
      "amount": "약간"
    },
    {
      "name": "참기름",
      "amount": "1작은술"
    },
    {
      "name": "통깨",
      "amount": "1작은술"
    }
  ],
  "steps": [
    {
      "id": 1,
      "description": "감자 2개는 껍질을 벗기고 약 2–3mm 두께로 가늘게 채 썹니다.",
      "image": "images/step-1.webp"
    },
    {
      "id": 2,
      "description": "감자채를 찬물에 약 5분 담가 전분을 빼고 두어 번 헹군 뒤, 체에 밭쳐 물기를 충분히 뺍니다.",
      "image": "images/step-2.webp"
    },
    {
      "id": 3,
      "description": "양파 1/4개와 당근 1/4개도 감자채와 비슷한 굵기로 썹니다.",
      "image": "images/step-3.webp"
    },
    {
      "id": 4,
      "description": "팬에 식용유 1과 1/2큰술을 두르고 중불로 달군 뒤 감자채와 당근채를 넣어 약 4분간 저어 가며 볶습니다.",
      "image": "images/step-4.webp"
    },
    {
      "id": 5,
      "description": "양파채를 넣고 2–3분 더 볶습니다. 감자채가 반투명해지고 속까지 익되 모양은 유지될 때까지 볶고, 덜 익었다면 1–2분 더 조리합니다.",
      "image": "images/step-5.webp"
    },
    {
      "id": 6,
      "description": "소금 1/3작은술과 후춧가루 약간을 넣어 간을 맞춥니다. 불을 끈 뒤 참기름 1작은술을 섞고 통깨 1작은술을 뿌려 마무리합니다.",
      "image": "images/step-6.webp"
    }
  ]
}
