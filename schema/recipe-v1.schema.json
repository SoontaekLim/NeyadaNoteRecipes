{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SoontaekLim/NeyadaNoteRecipes/blob/main/schema/recipe-v1.schema.json",
  "title": "NeyadaNote Recipe v1",
  "description": "Portable recipe format used by NeyadaNote.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "id",
    "title",
    "summary",
    "tags",
    "ingredients",
    "steps"
  ],
  "properties": {
    "format": {
      "const": "neyadanote.recipe"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "description": "Stable identifier. Official repository entries use the recipe directory name."
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$",
      "description": "Optional BCP 47-style content locale such as ko-KR."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "maxLength": 1000
    },
    "servings": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "coverImage": {
      "$ref": "#/$defs/assetPath"
    },
    "tags": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      }
    },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/ingredient"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "assetPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\\\.\\\\.(?:/|$))[A-Za-z0-9._/-]+$",
      "description": "Path relative to the recipe directory or package root."
    },
    "ingredient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "amount"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "amount": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "image": {
          "$ref": "#/$defs/assetPath"
        }
      }
    }
  }
}
