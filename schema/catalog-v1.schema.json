{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SoontaekLim/NeyadaNoteRecipes/blob/main/schema/catalog-v1.schema.json",
  "title": "NeyadaNote Recipe Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "recipes"],
  "properties": {
    "format": {"const": "neyadanote.recipe-catalog"},
    "schemaVersion": {"const": 1},
    "recipes": {
      "type": "array",
      "items": {"$ref": "#/$defs/recipe"}
    }
  },
  "$defs": {
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary", "tags", "packageUrl", "sha256", "sizeBytes"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
        },
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "summary": {"type": "string", "maxLength": 1000},
        "servings": {"type": "integer", "minimum": 1, "maximum": 100},
        "tags": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 40}
        },
        "packageUrl": {
          "type": "string",
          "pattern": "^packages/[a-z0-9][a-z0-9._-]*\\.neyada-recipe$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sizeBytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
